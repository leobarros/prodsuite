# ==========================================================================
# PRD//SUITE — variáveis de ambiente (copie para .env e NUNCA commite)
# ==========================================================================

# Obrigatória. Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-hex

# Política de senha: mínimo de 4 (requisito do projeto).
# Em instalações expostas publicamente, aumente (ex.: 12).
PASSWORD_MIN_LENGTH=4

# Interface/porta de publicação.
#  0.0.0.0        -> acessível em todas as interfaces (LAN + Tailscale)
#  100.x.y.z      -> apenas no IP Tailscale da máquina (recomendado no modo direto)
#  127.0.0.1      -> recomendado com `tailscale serve` (HTTPS na frente)
BIND_ADDR=0.0.0.0
APP_PORT=8090

# Fuso usado para "hoje", prazos e métricas de foco.
APP_TIMEZONE=America/Sao_Paulo

# true quando acessar por HTTPS (obrigatório com `tailscale serve`).
# Mantenha false se acessar por http://100.x.y.z:8090 (o cookie Secure
# impediria o login em HTTP).
COOKIE_SECURE=false

# Sessão expira após N minutos de inatividade.
SESSION_LIFETIME_MINUTES=30

# Dimensionamento de memória (2 workers × 2 threads é o baseline).
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
LOG_LEVEL=info

# Tentativas de login antes do bloqueio temporário.
LOGIN_ATTEMPT_LIMIT=5

# Após criar sua conta, defina false e recrie o container:
#   docker compose up -d --force-recreate
ALLOW_REGISTRATION=true
